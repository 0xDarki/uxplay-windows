<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">
     
  <!-- version number is mayor.minor.zero.uxplayversion -->
  <Package
    Id="uxplaywindows"
    Name="uxplay-windows"
    Manufacturer="leapbtw"
    Version="2.1.0.1736"
    UpgradeCode="00000eaf-dcca-458f-ab77-aaef11ce4ba8"
    Language="1033"
    Scope="perMachine">

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of uxplay-windows is already installed." />
    <WixVariable Id="WixUILicenseRtf" Value="./docs/LICENSE.rtf" />
    <MediaTemplate EmbedCab="yes" />

    <ui:WixUI Id="WixUI_FeatureTree" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLDIR" Name="uxplay-windows" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="uxplay-windows" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="AppExe" />
      <ComponentRef Id="ProgramMenuShortcutComponent" />
    </Feature>

    <Feature
      Id="DesktopShortcuts"
      Title="Desktop Shortcut"
      Description="Create a shortcut on the desktop"
      Level="1">
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>

    <ComponentGroup Id="AppFiles" Directory="INSTALLDIR">
      <Files Include="./release/**">
        <Exclude Files="./release/uxplay-windows.exe;**/*.pdb;**/uxplay-windows.exe" />
      </Files>
    </ComponentGroup>

    <ComponentGroup Id="AppExe" Directory="INSTALLDIR">
      <Component Id="AppExeComponent"
                 Guid="e5f23b9b-b726-4738-85ba-63892cff1924">
        <File Id="AppExeFile"
              Source="./release/uxplay-windows.exe"
              KeyPath="yes">
          <!-- Windows otherwise creates a Public-only rule from its first-run
               prompt; AirPlay must work on every profile. -->
          <fw:FirewallException Id="AppFirewallException"
                                Name="uxplay-windows"
                                Scope="any"
                                Profile="all" />
        </File>
        <!-- Clients discover the server over mDNS. Whichever Bonjour build
             answers (bundled or Apple's), its replies only happen if the
             queries get through the firewall. -->
        <fw:FirewallException Id="MdnsFirewallException"
                              Name="uxplay-windows mDNS (UDP 5353 In)"
                              Protocol="udp"
                              Port="5353"
                              Scope="localSubnet"
                              Profile="all" />
      </Component>
    </ComponentGroup>

    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="ProgramMenuFolder" />

    <Component Id="ProgramMenuShortcutComponent"
               Guid="cd347554-b38e-47f5-801d-152447366101"
               Directory="ProgramMenuFolder">
      <RegistryValue
        Root="HKCU"
        Key="Software\leapbtw\uxplay-windows"
        Name="ProgramMenuShortcut"
        Type="integer"
        Value="1"
        KeyPath="yes" />
      <Shortcut
        Name="uxplay-windows"
        Directory="ProgramMenuFolder"
        Target="[INSTALLDIR]uxplay-windows.exe"
        WorkingDirectory="INSTALLDIR"
        Advertise="no" />
    </Component>

    <Component Id="DesktopShortcutComponent"
               Guid="63bb69df-4292-4053-848c-fb369bed6273"
               Directory="DesktopFolder">
      <RegistryValue
        Root="HKCU"
        Key="Software\leapbtw\uxplay-windows"
        Name="DesktopShortcut"
        Type="integer"
        Value="1"
        KeyPath="yes" />
      <Shortcut
        Name="uxplay-windows"
        Directory="DesktopFolder"
        Target="[INSTALLDIR]uxplay-windows.exe"
        WorkingDirectory="INSTALLDIR"
        Advertise="no" />
    </Component>

  </Package>
</Wix>
